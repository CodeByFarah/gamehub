# ---------------------------------------------------------------------------
# GameHub - example environment file.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored.
#   cp .env.example .env          (bash)
#   Copy-Item .env.example .env   (PowerShell)
#
# NOTHING here is a real credential. Every value is a local development
# placeholder. Production values live in Google Secret Manager and are
# injected as environment variables by Cloud Run (see docs/deployment.md).
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=gamehub
POSTGRES_USER=gamehub
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gamehub

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Blank for local docker-compose (no auth). Required for Memorystore.
REDIS_PASSWORD=

# --- Kafka -----------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EXTERNAL_PORT=9092
KAFKA_CONSUMER_GROUP_PREFIX=gamehub

# --- Security --------------------------------------------------------------
# HS256 signing key, must be >= 32 bytes. Generate one:
#   openssl rand -base64 48
# Never reuse this example value outside local development.
JWT_SECRET=local-development-only-secret-replace-me-with-48-random-bytes
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- AI / Gemini -----------------------------------------------------------
# Obtain from https://aistudio.google.com/apikey
# If GEMINI_API_KEY is empty the backend still starts and AI features degrade
# to the deterministic fallback path (see docs/ai-architecture.md).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_MS=8000
GEMINI_MAX_RETRIES=2

# --- Observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=gamehub-backend
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# --- Backend runtime -------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# --- Google Cloud (deployment only, unused locally) ------------------------
GCP_PROJECT_ID=
GCP_REGION=europe-west1
ARTIFACT_REGISTRY_REPO=gamehub
